{
  "name": "tg-cc-bot",
  "version": "0.3.0",
  "private": true,
  "description": "Telegram remote control for Claude Code (Agent SDK, subscription login)",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "start:node": "node --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "lint:sh": "node scripts/check-shell.ts",
    "check": "npm run typecheck && npm test && npm run lint:sh",
    "test:deploy": "bash deploy/test/run.sh",
    "probe": "node scripts/probe-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "grammy": "^1.46.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
