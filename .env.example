# Telegram bot token from @BotFather (required).
# Also enable Threaded Mode for the bot in @BotFather: every Claude session lives in a tab.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (required).
# Anyone else who writes to the bot is told their ID, so you can add it here.
ALLOWED_USER_IDS=

# --- Projects -----------------------------------------------------------------
# Directory of the first project ("home"). Add more in Telegram: /project add <name> <path>
DEFAULT_CWD=
# Comma-separated directories projects must live in (empty = anywhere)
ALLOWED_ROOTS=

# --- Defaults for new tabs (changeable in Telegram with /settings) ---------------
# Model alias or ID (empty = Claude Code default)
DEFAULT_MODEL=
# auto | default | acceptEdits | plan | dontAsk | bypassPermissions
DEFAULT_PERMISSION_MODE=auto
# low | medium | high | xhigh | max (empty = model default)
DEFAULT_EFFORT=

# --- Claude Code processes ------------------------------------------------------
# A tab only has a running Claude Code process while it is in use. Idle processes
# are closed and resumed transparently on the next message.
# Maximum processes at the same time (plan a few hundred MB RAM each)
MAX_LIVE_SESSIONS=3
# Close a process after this many idle minutes
SESSION_IDLE_MINUTES=15
# Close a process kept alive only by background tasks after this many minutes
BACKGROUND_MAX_MINUTES=120
# Path to a system-installed `claude` (empty = the binary bundled with the Agent SDK)
CLAUDE_PATH=

# --- Bot ----------------------------------------------------------------------
# Where bot state (projects, tabs, settings) is stored
STATE_FILE=./data/state.json
# Live preview while Claude writes: draft (sendMessageDraft) | edit (edit a placeholder) | off
STREAM_MODE=draft
# Auto-deny unanswered permission prompts after this many ms
PERMISSION_TIMEOUT_MS=600000
# debug | info | warn | error
LOG_LEVEL=info

# Optional: long-lived subscription token from `claude setup-token`
# (alternative to signing in once with `claude` -> /login as the service user)
# CLAUDE_CODE_OAUTH_TOKEN=
